#!/bin/bash
set -euo pipefail

# Trigger onchange when nix-config changes:
# nix-config hash: {{ if stat (joinPath .chezmoi.homeDir ".config/home-manager/flake.lock") }}{{ output "sha256sum" (joinPath .chezmoi.homeDir ".config/home-manager/flake.lock") }}{{ else }}first-run{{ end }}

echo "==> Installing/updating Nix packages via home-manager..."

# Step 1: Install Determinate Nix if not present
if ! command -v nix &>/dev/null; then
  echo "==> Nix not found, installing Determinate Nix..."
{{ if eq .chezmoi.os "darwin" -}}
  # macOS: use the native .pkg installer (handles macOS quirks better)
  PKG_URL="$(curl -sSf -L https://install.determinate.systems/nix-installer-pkg/stable | jq -r '.url_prefix')/Universal"
  TMPDIR="$(mktemp -d)"
  curl -sSf -L "${PKG_URL}" -o "${TMPDIR}/nix-installer.pkg"
  sudo installer -pkg "${TMPDIR}/nix-installer.pkg" -target /
  rm -rf "${TMPDIR}"
{{ else -}}
  curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm
{{ end -}}
fi

# Step 2: Ensure Nix is on PATH for this session
if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  # shellcheck source=/dev/null
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi

# Step 3: Run home-manager switch
if command -v home-manager &>/dev/null; then
  home-manager switch --flake ~/.config/home-manager
else
  echo "==> home-manager not found, bootstrapping via nix run..."
  nix run home-manager -- switch --flake ~/.config/home-manager
fi

echo "==> Nix packages installed successfully."

{{ if eq .chezmoi.os "darwin" -}}
# Step 4: Install Homebrew on macOS
if ! command -v brew &>/dev/null; then
  echo "==> Homebrew not found, installing..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  echo "==> Homebrew installed successfully."
else
  echo "==> Homebrew already installed."
fi
{{ end -}}
