[user]
	email = {{ .email }}
	name = {{ .name }}
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[core]
	excludesFile = ~/.gitignore
[lfs]
	locksverify = true
	concurrenttransfers = {{ .git_lfs_concurrent_transfers }}
	concurrent = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
